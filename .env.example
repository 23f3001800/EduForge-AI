# EduForge AI — copy to .env and fill in. Boot fails fast on a missing required key.

# ── LLM provider selection ──────────────────────────────────────────────────
# production = openrouter (free models — graded output, deployed demo, e2e runs)
# dev        = openrouter (smallest model — fast single-stage iteration)
# groq       = groq       (alternative; free tier caps at 8000 TPM)
# gemini_dev = gemini     (alternative)
# ci         = replay     (recorded cassettes; no network, no key)
LLM_PROFILE=production

# Required when LLM_PROFILE=production or dev. Free key: https://openrouter.ai/keys
# The default profile uses only ':free' models, so a full run costs $0.00.
Open_Router_API_KEY=

# Required when LLM_PROFILE=groq
GROQ_API_KEY=

# Anthropic is implemented but OFF by default. A key here is not enough —
# set ALLOW_ANTHROPIC=true to make it callable. Billing against that key should
# be a decision, not a config typo.
ALLOW_ANTHROPIC=false
ANTHROPIC_API_KEY=

# Required when LLM_PROFILE=gemini_dev
GEMINI_API_KEY=

# ── storage ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://eduforge:eduforge@localhost:5432/eduforge
BLOB_BACKEND=local          # local | s3
BLOB_LOCAL_PATH=./blob

# ── retrieval ───────────────────────────────────────────────────────────────
# none  = BM25 only (always works, lowest memory)
# local = on-box embedding model
# api   = hosted embedding provider
EMBEDDINGS=none

# ── limits & safety ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_PAGES=300
PARSE_TIMEOUT_S=90
LLM_CONCURRENCY=4
JOB_TOKEN_BUDGET=1500000
RETENTION_DAYS=30

# Optional shared access code for the public demo. Unset = open (rate-limited).
DEMO_ACCESS_CODE=
