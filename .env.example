# EduForge AI — copy to .env and fill in. Boot fails fast on a missing required key.

# ── LLM provider selection ──────────────────────────────────────────────────
# production = groq   (graded output, deployed demo, end-to-end runs)
# dev        = gemini (single-stage iteration)
# ci         = replay (recorded cassettes; no network, no key)
LLM_PROFILE=production

# Required when LLM_PROFILE=production (Groq)
GROQ_API_KEY=

# Anthropic is implemented but OFF by default. A key here is not enough —
# set ALLOW_ANTHROPIC=true to make it callable.
ALLOW_ANTHROPIC=false
ANTHROPIC_API_KEY=

# Required when LLM_PROFILE=dev
GEMINI_API_KEY=

# ── storage ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://eduforge:eduforge@localhost:5432/eduforge
BLOB_BACKEND=local          # local | s3
BLOB_LOCAL_PATH=./blob

# ── retrieval ───────────────────────────────────────────────────────────────
# none  = BM25 only (always works, lowest memory)
# local = on-box embedding model
# api   = hosted embedding provider
EMBEDDINGS=none

# ── limits & safety ─────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
MAX_PAGES=300
PARSE_TIMEOUT_S=90
LLM_CONCURRENCY=4
JOB_TOKEN_BUDGET=1500000
RETENTION_DAYS=30

# Optional shared access code for the public demo. Unset = open (rate-limited).
DEMO_ACCESS_CODE=
