# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# node / frontend
node_modules/
# Next.js build output and its webpack cache. The cache alone is ~150MB of
# binary packs that change on every build — it has no business in history.
frontend/.next/
frontend/dist/
frontend/out/
next-env.d.ts
frontend/.vite/

# local artifacts
/data/
/uploads/
/blob/
evals/reports/*
!evals/reports/.gitkeep

# os / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*:Zone.Identifier
